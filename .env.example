# Database — matches docker-compose.yml
DATABASE_URL="postgresql://bete:bete@localhost:5433/bete?schema=public"

# Auth.js
# Generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google OAuth (optional — the Google button is hidden when these are unset)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Cloudinary (optional — uploads fall back to local disk when unset)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# Email (optional — alerts log to the console when unset)
RESEND_API_KEY=""
EMAIL_FROM="Bete <hello@bete.et>"

# Protects the Vercel Cron endpoint
CRON_SECRET="local-dev-cron-secret"

# Public site URL, used for canonical URLs, sitemap and OG images
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ETB per 1 USD, used by the currency toggle
NEXT_PUBLIC_USD_TO_ETB="163"
